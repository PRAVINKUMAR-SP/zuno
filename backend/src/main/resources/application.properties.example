spring.application.name=ZunoBackend
server.port=8081

# MySQL Database (this machine runs MySQL80 on port 3307 by default; override via env vars)
spring.datasource.url=jdbc:mysql://${MYSQL_HOST:localhost}:${MYSQL_PORT:3307}/${MYSQL_DB:zuno_db}?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=${MYSQL_USER:root}
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Local Python Qwen3-4B AI inference service
zuno.ai.base-url=${ZUNO_AI_URL:http://127.0.0.1:8001}
zuno.ai.timeout-seconds=${ZUNO_AI_TIMEOUT:45}

# CORS for React Vite frontend
zuno.cors.allowed-origins=${ZUNO_CORS_ORIGINS:http://localhost:5173,http://127.0.0.1:5173}
